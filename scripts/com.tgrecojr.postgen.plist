<?xml version="1.0" encoding="UTF-8"?>
<!-- launchd job: Mon/Wed/Fri at 07:30. Install with:
     cp scripts/com.tgrecojr.postgen.plist ~/Library/LaunchAgents/
     sed -i '' "s|__REPO__|$(pwd)|" ~/Library/LaunchAgents/com.tgrecojr.postgen.plist
     launchctl load ~/Library/LaunchAgents/com.tgrecojr.postgen.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.tgrecojr.postgen</string>
  <key>ProgramArguments</key>
  <array><string>__REPO__/scripts/run-daily.sh</string></array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
  </array>
  <key>StandardOutPath</key><string>__REPO__/data/logs/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__REPO__/data/logs/launchd.err.log</string>
</dict>
</plist>
