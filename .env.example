# Copy to .env (never committed). Compose passes this file to the container.

# Anthropic API key (required).
ANTHROPIC_API_KEY=sk-ant-...

# Only needed when POSTGEN_RESEARCH_PROVIDER=tavily
TAVILY_API_KEY=

# --- Optional overrides (defaults shown) ---
# POSTGEN_MODEL=claude-opus-5
# POSTGEN_MODEL_RESEARCH=            # per-step override, e.g. claude-sonnet-5
# POSTGEN_MODEL_WRITER=
# POSTGEN_MODEL_EVALUATOR=
# POSTGEN_MODEL_VOICE=
# POSTGEN_MODEL_TOPICS=
# POSTGEN_EFFORT=high                # low | medium | high | xhigh | max
# POSTGEN_ENABLE_FALLBACKS=true      # server-side refusal fallbacks
# POSTGEN_RESEARCH_PROVIDER=anthropic  # anthropic | tavily
# POSTGEN_RESEARCH_MAX_SEARCHES=8
# POSTGEN_MAX_REVISIONS=2
# POSTGEN_PASS_THRESHOLD=7.5
# POSTGEN_TOPIC_COOLDOWN_DAYS=60
# POSTGEN_EXEMPLAR_COUNT=4
# POSTGEN_RECENT_FEEDBACK_COUNT=8
# POSTGEN_PORT=8790
# POSTGEN_ALLOWED_HOSTS=localhost,127.0.0.1   # add your Tailscale/proxy hostname; "*" disables
# POSTGEN_DATA_DIR=data              # container sets /data; local dev uses ./data
# POSTGEN_HOST=127.0.0.1             # container sets 0.0.0.0
